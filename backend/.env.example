DATABASE_URL=./travel.db
JWT_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long

# AI Agent Configuration
AI_AGENT_PROVIDER=ollama

# Ollama Configuration
# Docker Compose: use the service name as the host.
# Running backend directly on the host: change to http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
OLLAMA_ITINERARY_MODEL=phi3
OLLAMA_FALLBACK_MODEL=phi3

# Monitoring Configuration
PROMETHEUS_URL=http://prometheus:9090

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

ENABLE_METRICS_ENDPOINT=false

# Admin Configuration
ADMIN_API_TOKEN=
